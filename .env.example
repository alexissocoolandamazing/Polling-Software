# Browser-safe Supabase project values (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Canonical public URL, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Cloudflare Worker base URL. The browser converts HTTPS to WSS.
NEXT_PUBLIC_REALTIME_RELAY_URL=https://pulsepoll-realtime-relay.YOUR_SUBDOMAIN.workers.dev

# Server-only shared secret; use the same value for the Worker's RELAY_SHARED_SECRET.
REALTIME_RELAY_SECRET=replace_with_a_long_random_value
