{
  "name": "polling-software",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:relay": "wrangler deploy --dry-run --outdir dist --config relay-worker/wrangler.jsonc",
    "deploy:relay": "wrangler deploy --config relay-worker/wrangler.jsonc",
    "dev:relay": "wrangler dev --config relay-worker/wrangler.jsonc",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:relay": "vitest run --config relay-worker/vitest.config.mts",
    "test:watch": "vitest",
    "typecheck:relay": "npm run types:relay:check && tsc --noEmit --project relay-worker/tsconfig.json",
    "types:relay": "wrangler types relay-worker/worker-configuration.d.ts --include-runtime false --env-file relay-worker/.dev.vars.example --config relay-worker/wrangler.jsonc",
    "types:relay:check": "wrangler types relay-worker/worker-configuration.d.ts --check --include-runtime false --env-file relay-worker/.dev.vars.example --config relay-worker/wrangler.jsonc",
    "load:smoke": "k6 run load-tests/poll-session.js"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.10",
    "@cloudflare/workers-types": "5.20260916.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.132.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
